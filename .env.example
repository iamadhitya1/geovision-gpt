# ---------------------------------------------------------------------------
# GeoVisionGPT — environment configuration
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
GVG_ENVIRONMENT=development          # development | staging | production
GVG_DEBUG=true
GVG_PROJECT_NAME=GeoVisionGPT
GVG_API_V1_PREFIX=/api/v1
GVG_LOG_LEVEL=INFO
GVG_LOG_JSON=false                   # true in production

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
GVG_SECRET_KEY=CHANGE_ME_dev_only_secret_key_at_least_32_characters_long
GVG_JWT_ALGORITHM=HS256
GVG_ACCESS_TOKEN_EXPIRE_MINUTES=30
GVG_REFRESH_TOKEN_EXPIRE_DAYS=14
GVG_PASSWORD_MIN_LENGTH=10

# --- CORS ---
GVG_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database ---
# local-lite profile (no Docker needed):
GVG_DATABASE_URL=sqlite+aiosqlite:///./geovision.db
# local-full profile:
# GVG_DATABASE_URL=postgresql+asyncpg://geovision:geovision@localhost:5432/geovision
GVG_DB_ECHO=false
GVG_DB_POOL_SIZE=10
GVG_DB_MAX_OVERFLOW=20

# --- Cache / rate limiting ---
GVG_CACHE_BACKEND=memory             # memory | redis
GVG_REDIS_URL=redis://localhost:6379/0
GVG_RATE_LIMIT_ENABLED=true
GVG_RATE_LIMIT_LOGIN_ATTEMPTS=5      # per window, per IP
GVG_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
GVG_RATE_LIMIT_DEFAULT_REQUESTS=120
GVG_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60

# --- Object storage (Module 2) ---
GVG_STORAGE_BACKEND=filesystem       # filesystem | minio | s3
GVG_STORAGE_ROOT=./storage
GVG_MINIO_ENDPOINT=localhost:9000
GVG_MINIO_ACCESS_KEY=minioadmin
GVG_MINIO_SECRET_KEY=minioadmin
GVG_MINIO_BUCKET=geovision

# --- Bootstrap admin (created on first startup if absent) ---
# Must be a routable domain — reserved TLDs (.local, .test, .example) fail email validation.
GVG_FIRST_ADMIN_EMAIL=admin@geovisiongpt.io
GVG_FIRST_ADMIN_PASSWORD=ChangeMe_Please_2026
GVG_FIRST_ADMIN_NAME=Platform Administrator

# --- Inference backend (Module 6/7) ---
GVG_INFERENCE_BACKEND=null           # null | openai_compatible | local_transformers
GVG_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
GVG_VLM_BASE_URL=https://openrouter.ai/api/v1
GVG_VLM_API_KEY=
